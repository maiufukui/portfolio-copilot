# Copy this file to .env and fill in real values. Never commit .env.

# Required to test eval Q1 (RAG over filings + transcripts)
OPENAI_API_KEY=sk-...

# Portkey — LLM gateway (assignment requirement: "use an LLM gateway of your
# choice"). Set this and llm_gateway.py automatically routes every
# ChatOpenAI/OpenAIEmbeddings instance the app builds through Portkey's
# gateway; leave it unset and the app falls back to calling OpenAI directly.
# Sign up: https://portkey.ai/pricing (free Developer tier)
PORTKEY_API_KEY=
# If your Portkey account has "block_inline_config" enabled, the plain
# "openai" provider string in the x-portkey-provider header gets rejected
# (BadRequestError: inline_provider_blocked). Create an OpenAI Integration
# in the Portkey dashboard and set this to its slug instead, e.g. @my-openai.
# PORTKEY_PROVIDER=openai

# Tavily — live web search tool, used by eval Q2 and Q8.
# Sign up: https://www.tavily.com/pricing (free tier, 1k credits/mo)
TAVILY_API_KEY=

# Finnhub — market data + insider transactions tool, used by eval Q5.
# Sign up: https://finnhub.io/register (free tier, 60 calls/min)
FINNHUB_API_KEY=

# Cohere — reranker for parent-child retrieval (item 4), replacing the
# hardcoded prefer_source_suffixes workaround in parent_child_retriever.py.
# Sign up: https://dashboard.cohere.com (Trial key, free -- 1,000 calls/mo
# across all endpoints, confirmed live 2026-07-25; not for production/
# commercial use, which doesn't apply to this capstone).
COHERE_API_KEY=

# Postgres (Render) — required. Backs price_snapshots (real historical
# closes for get_market_data's week/month price-change math, replacing
# the ephemeral-filesystem gap that broke this across every free-tier
# restart) plus three schema-only tables (health_score_history,
# user_memory, news_dedup) reserved for later work. app/db.py normalizes
# either postgres:// or postgresql:// automatically. server.py fails
# loudly at startup if this is unset -- it's a hard requirement, not
# optional like the FMP key this replaced.
DATABASE_URL=postgresql://user:password@host/dbname

# LangSmith — optional tracing for app/graph.py. Set both to see every tool
# call, model call, exact prompt, latency, and token count as a nested trace
# at smith.langchain.com. No code change needed beyond these two vars --
# LangChain/LangGraph auto-instrument. Sign up: https://smith.langchain.com
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
